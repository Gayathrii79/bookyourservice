# ─────────────────────────────────────────────
# BookYourService — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ─────────────────────────────────────────────

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/bookyourservice?retryWrites=true&w=majority

# Port for the Express server
PORT=5000

# Allowed frontend origin for CORS (no trailing slash)
# Development:   http://localhost:3000
# Production:    https://yourdomain.com
FRONTEND_ORIGIN=http://localhost:3000

# Node environment: development | production
NODE_ENV=development
